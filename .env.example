APP_URL="http://localhost:3000"
# MongoDB must support transactions (Atlas or a local replica set).
DATABASE_URL="mongodb://localhost:27017/wachira?replicaSet=rs0"
AUTH_SECRET=""
ADMIN_EMAILS=""
NEXT_PUBLIC_WHATSAPP=""

# Mock payments are accepted only outside production.
MPESA_MODE="mock"
# PayHero API credentials and the numeric ID from My Payment Channels.
PAYHERO_API_USERNAME=""
PAYHERO_API_PASSWORD=""
PAYHERO_CHANNEL_ID=""
# Independent random secret of at least 32 characters for payment callbacks.
PAYHERO_CALLBACK_SECRET=""
# Optional: keep the previous MPESA_CALLBACK_SECRET for outstanding Daraja callbacks.

MAIL_HOST=""
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Wachira"

# Independent random secret, at least 32 characters. Used by the email worker.
JOBS_SECRET=""
# Set only if your proxy overwrites this header with a verified client IP.
AUTH_TRUSTED_IP_HEADER=""

# Optional absolute path on a persistent disk. Defaults to ./uploads/products.
IMAGE_UPLOAD_DIR=""
